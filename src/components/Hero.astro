---
import Button from "./Button.astro";
---

<section
  class="relative bg-gradient-to-r from-blue-500 to-indigo-600 dark:from-gray-800 dark:to-gray-900 text-white py-24 px-4 sm:px-6 lg:px-8"
>
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight">
      Build Beautiful Websites Faster
    </h1>
    <p
      class="mt-6 text-xl sm:text-2xl max-w-2xl mx-auto text-blue-100 dark:text-gray-300"
    >
      Astro and Tailwind CSS provide the perfect combination for building
      modern, responsive, and performant websites with ease.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
      <Button
        href="#"
        variant="primary"
        size="lg"
        ariaLabel="Get started with Astro"
      >
        Get Started
      </Button>
      <Button
        href="#"
        variant="secondary"
        size="lg"
        ariaLabel="View the GitHub repository"
      >
        View on GitHub
      </Button>
    </div>
  </div>
  <div
    class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white dark:from-gray-900 to-transparent"
  >
  </div>
</section>
