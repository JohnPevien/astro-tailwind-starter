---
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  author?: string;
  imageUrl?: string;
  url?: string;
  type?: string;
  siteName?: string;
  twitterHandle?: string;
  noIndex?: boolean;
  noFollow?: boolean;
  canonicalUrl?: string;
  structuredData?: object;
}
import Navigation from "@/blocks/navigation.astro";
import Footer from "@/blocks/footer.astro";
import Head from "@/components/Head.astro";
import "../styles/global.css";

const {
  title,
  description,
  keywords,
  author,
  imageUrl,
  url,
  type,
  siteName,
  twitterHandle,
  noIndex,
  noFollow,
  canonicalUrl,
  structuredData,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      keywords={keywords}
      author={author}
      imageUrl={imageUrl}
      url={url}
      type={type}
      siteName={siteName}
      twitterHandle={twitterHandle}
      noIndex={noIndex}
      noFollow={noFollow}
      canonicalUrl={canonicalUrl}
      structuredData={structuredData}
    />
  </head>
  <body>
    <Navigation />
    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
